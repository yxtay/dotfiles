{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "fallbackModel": ["bedrock.claude-sonnet-5"],
  "modelOverrides": {
    "claude-fable-5-1": "bedrock.claude-fable-5-1",
    "claude-haiku-4-5": "bedrock.claude-haiku-4-5",
    "claude-sonnet-5": "bedrock.claude-sonnet-5",
    "claude-sonnet-5-5": "bedrock.claude-sonnet-5-5",
    "claude-opus-5": "bedrock.claude-opus-5",
    "claude-opus-5-5": "bedrock.claude-opus-5-5"
  },
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "bedrock.claude-fable-5-1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "bedrock.claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "bedrock.claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "bedrock.claude-sonnet-5-5"
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 200000,
  "autoMemoryEnabled": true,
  "awaySummaryEnabled": true,
  "editorMode": "normal",
  "effortLevel": "high",
  "fileCheckpointingEnabled": true,
  "outputStyle": "Concise",
  "preferredNotifChannel": "terminal_bell",
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "~/.agentmemory",
      "~/.agents",
      "~/.claude",
      "~/wiki"
    ],
    "ask": [
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.mcp.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(~/.aws/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.docker/**)",
      "Edit(~/.gcp/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.gcp/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)"
    ],
    "deny": []
  },
  "sandbox": {
    "enabled": true,
    "enableWeakerNetworkIsolation": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
