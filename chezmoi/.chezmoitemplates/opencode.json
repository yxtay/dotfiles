{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "compaction": {
    "prune": true
  },
  "permission": {
    "bash": {
      "*": "ask"
    },
    "edit": {
      "**/.env": "ask",
      "**/.env.example": "allow",
      "**/.env.*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "deny",
      "~/.gnupg/**": "deny",
      "~/wiki/**": "allow"
    },
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "~/.opencode-mem/**": "allow",
      "~/wiki/**": "allow"
    },
    "read": {
      "**/.env": "ask",
      "**/.env.example": "allow",
      "**/.env.*": "ask",
      "~/.ssh/**": "ask",
      "~/.aws/**": "ask",
      "~/.kube/**": "ask",
      "~/.gnupg/**": "ask"
    }
  },
  "plugin": [
    "opencode-mem",
    "opencode-models-discovery",
    "@devtheops/opencode-plugin-otel",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "codebase-memory-mcp": {
      "command": ["codebase-memory-mcp"],
      "enabled": true,
      "type": "local"
    }
  }
}
