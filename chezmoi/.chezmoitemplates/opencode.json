{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "compaction": {
    "prune": true
  },
  "permission": {
    "edit": {
      "~/wiki/**": "allow"
    },
    "external_directory": {
      "~/wiki/**": "allow"
    }
  },
  "plugin": ["@dietrichgebert/ponytail", "@zilliz/memsearch-opencode"],
  "mcp": {
    "codebase-memory-mcp": {
      "command": ["codebase-memory-mcp"],
      "enabled": true,
      "type": "local"
    }
  }
}
