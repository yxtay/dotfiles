{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "compaction": {
    "prune": true
  },
  "permission": {
    "bash": {
      "cat *": "allow",
      "diff *": "allow",
      "echo *": "allow",
      "fd *": "allow",
      "file *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "type *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "yq *": "allow"
    },
    "edit": {
      "**/.env": "ask",
      "**/.env.example": "allow",
      "**/.env.*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "deny",
      "~/.gnupg/**": "deny",
      "~/wiki/**": "allow"
    },
    "external_directory": {
      "~/.agentmemory/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.memsearch/**": "allow",
      "~/wiki/**": "allow"
    },
    "read": {
      "**/.env": "ask",
      "**/.env.example": "allow",
      "**/.env.*": "ask",
      "~/.aws/**": "ask",
      "~/.kube/**": "ask",
      "~/.gnupg/**": "ask",
      "~/.ssh/**": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "question": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "plugin": [
    "opencode-models-discovery",
    "@devtheops/opencode-plugin-otel",
    "@dietrichgebert/ponytail",
    "./plugins/agentmemory-capture.ts",
    "./plugins/cbm-augment.ts"
  ],
  "mcp": {
    "agentmemory": {
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true,
      "type": "local"
    },
    "codebase-memory-mcp": {
      "command": ["codebase-memory-mcp"],
      "enabled": true,
      "type": "local"
    }
  }
}
