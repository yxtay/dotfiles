{
  "name": "update-summary",
  "description": "Update summary skill with agentmemory server auto-start",
  "skills": "./",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/start-agentmemory.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
