{
  "name": "update-summary",
  "description": "Standup digest skill + SessionEnd hooks that save the cass-memory diary it reads and refresh the cass index",
  "skills": "./",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cm hook session-end"
          },
          {
            "type": "command",
            "command": "nohup cass index >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  }
}
