{
  "name": "okf",
  "description": "OKF skill + wiki maintenance from session narratives",
  "skills": "./",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/okf-wiki-maintenance.sh",
            "timeout": 600,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/okf-wiki-maintenance.sh",
            "timeout": 600,
            "async": true
          }
        ]
      }
    ]
  }
}
