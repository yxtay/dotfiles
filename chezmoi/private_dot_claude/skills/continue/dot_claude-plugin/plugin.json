{
  "name": "continue",
  "description": "Continue skill + hooks that point a fresh or cleared session at the previous transcript",
  "skills": "./",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-previous-transcript.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/record-cleared-transcript.sh"
          }
        ]
      }
    ]
  }
}
