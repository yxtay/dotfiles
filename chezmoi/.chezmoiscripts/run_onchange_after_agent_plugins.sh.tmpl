#!/usr/bin/env bash
set -euo pipefail

npm install -g @caveman-ai/cli
caveman setup --install

if command -v codebase-memory-mcp >/dev/null; then
  codebase-memory-mcp install --yes
  codebase-memory-mcp config set auto_index true
fi

{{- if not .is_ci }}
npx --yes ctx7 setup --cli --opencode --yes
if command -v claude >/dev/null; then
  npx --yes ctx7 setup --cli --claude --yes
fi
{{- end }}

if command -v lean-ctx >/dev/null; then
  if command -v claude >/dev/null; then
    lean-ctx wrap claude
  fi
  if command -v opencode >/dev/null; then
    lean-ctx wrap opencode
  fi
fi

agents=(universal)
if command -v claude >/dev/null; then
  agents+=(claude-code)
fi

repo_skills=(
  mattpocock/skills=wayfinder,grill-with-docs,to-spec,to-tickets,triage,handoff,implement
  mattpocock/skills=grilling,domain-modeling,research,prototype,codebase-design,tdd,diagnosing-bugs
  mattpocock/skills=setup-matt-pocock-skills,improve-codebase-architecture,writing-for-agents
)
for entry in "${repo_skills[@]}"; do
  repo="${entry%%=*}"
  skills_csv="${entry#*=}"
  IFS=',' read -r -a skills <<<"${skills_csv}"
  npx --yes skills add "${repo}" --skill "${skills[@]}" --global --agent "${agents[@]}" --yes
done
