[".local/bin/codebase-memory-mcp"]
  type = "archive-file"
  url = "{{ gitHubLatestReleaseAssetURL "DeusData/codebase-memory-mcp" (printf "codebase-memory-mcp-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch) }}"
  path = "codebase-memory-mcp"
  executable = true
  refreshPeriod = "168h"

{{- if .is_ephemeral }}
[".local/bin/fzf"]
  type = "archive-file"
  url = "{{ gitHubLatestReleaseAssetURL "junegunn/fzf" (printf "fzf-*-%s_%s.tar.gz" .chezmoi.os .chezmoi.arch) }}"
  path = "fzf"
  executable = true
  refreshPeriod = "168h"
{{- end }}

{{- $agentmemoryTag := toString (gitHubLatestRelease "rohitg00/agentmemory").TagName }}
[".config/opencode/plugins/agentmemory-capture.ts"]
  type = "archive-file"
  url = "{{ printf "https://github.com/rohitg00/agentmemory/archive/refs/tags/%s.tar.gz" $agentmemoryTag }}"
  path = "{{ printf "agentmemory-%s/plugin/opencode/agentmemory-capture.ts" (trimPrefix "v" $agentmemoryTag) }}"
  refreshPeriod = "168h"
